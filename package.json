{
  "name": "ssam-talk-school-starter",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "type": "module",
  "scripts": {
    "configure:school": "node scripts/setup-school.mjs",
    "check:setup": "node scripts/check-setup.mjs",
    "check:deploy": "node scripts/check-setup.mjs --deploy",
    "prepare:rules": "node scripts/prepare-firestore-rules.mjs",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:rules": "node scripts/test-rules.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "firebase": "12.16.0",
    "firebase-admin": "13.6.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vercel/node": "5.9.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "firebase-tools": "15.28.2",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
